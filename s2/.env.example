# S2 Postiz AI configuration
# Never commit real secrets.

# This is the S2 AI Gateway bearer token, NOT a paid OpenAI key.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://host.docker.internal:8787/v1
OPENAI_MODEL=creative

# Keep Postiz image generation separate from the text gateway.
# Leave blank while MoneyPrinterTurbo remains the S2 media-generation engine.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=chatgpt-image-latest
